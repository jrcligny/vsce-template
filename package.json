{
	"name": "@jrcligny/vsce-template",
	"version": "1.0.0",
	"author": {
		"name": "Jean-Rémy Cligny",
		"url": "https://github.com/jrcligny"
	},
	"description": "This is a template for creating a new VS Code extension.",
	"license": "SEE LICENSE IN LICENSE.md",
	"homepage": "https://github.com/jrcligny/vsce-template",
	"repository": {
		"type": "git",
		"url": "https://github.com/jrcligny/vsce-template"
	},
	"bugs": {
		"url": "https://github.com/jrcligny/vsce-template/issues"
	},
	"private": true,
	"main": "./package-out/app/extension.js",
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@tsconfig/node20": "^20.1.4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.13.5",
		"@types/vscode": "^1.97.0",
		"@vscode/test-electron": "^2.4.1",
		"@vscode/vsce": "3.2.2",
		"esbuild": "^0.25.0",
		"eslint": "^9.21.0",
		"gulp": "^5.0.0",
		"mocha": "^11.1.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.25.0"
	},
	"scripts": {
		"lint": "eslint --config eslint.config.mjs",
		"compile": "tsc --noEmit && gulp -f ./tasks/build/index.mjs compile",
		"pretest": "gulp -f ./tasks/test/index.mjs clean && tsc && npm run compile",
		"test": "gulp -f ./tasks/test/index.mjs run --enable-source-maps",
		"test:ci": "gulp -f ./tasks/test/index.mjs runCI --enable-source-maps",
		"package": "tsc --noEmit && gulp -f ./tasks/build/index.mjs pack"
	}
}
